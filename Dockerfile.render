# Dockerfile for Render Web Service (PHP 8.2 / Laravel 12)
FROM php:8.2-cli-alpine

# Install system packages & PHP extensions
RUN apk add --no-cache \
    curl \
    libpng-dev \
    libxml2-dev \
    zip \
    libzip-dev \
    unzip \
    sqlite-dev \
    oniguruma-dev \
    icu-dev

RUN docker-php-ext-install \
    pdo_mysql \
    pdo_sqlite \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip \
    opcache \
    intl

WORKDIR /var/www/html

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy application files
COPY . /var/www/html

# Install production dependencies
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Create SQLite database directory & file if needed
RUN mkdir -p database /var/www/html/storage /var/www/html/bootstrap/cache && \
    touch database/database.sqlite && \
    chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache database

# Make entrypoint executable
RUN chmod +x /var/www/html/docker/render-entrypoint.sh

EXPOSE 10000

ENTRYPOINT ["/var/www/html/docker/render-entrypoint.sh"]
